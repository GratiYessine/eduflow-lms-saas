# Copy to .env for local overrides. Do not commit real secrets.

# Backend security
JWT_SECRET=replace-with-a-long-random-production-secret-at-least-32-characters
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
CORS_ALLOWED_ORIGINS=http://localhost:4200
FRONTEND_BASE_URL=http://localhost:4200

# Database
DB_URL=jdbc:postgresql://postgres:5432/lms
DB_USERNAME=lms
DB_PASSWORD=replace-with-production-db-password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
AUTH_RATE_LIMIT_BACKEND=redis

# SMTP provider configuration.
# For production, use your approved SMTP provider values here.
MAIL_ENABLED=true
MAIL_FROM=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_AUTH=true
SMTP_STARTTLS=true

# Gmail SMTP example for local testing with a Gmail inbox.
# Requires a Google App Password, not your normal Gmail password:
# https://myaccount.google.com/apppasswords
# MAIL_FROM=your-gmail-address@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-gmail-address@gmail.com
# SMTP_PASSWORD=your-16-character-google-app-password
# SMTP_AUTH=true
# SMTP_STARTTLS=true

# S3-compatible storage. Local Docker uses MinIO.
FILE_STORAGE_PROVIDER=minio
MINIO_ROOT_USER=replace-with-minio-access-key
MINIO_ROOT_PASSWORD=replace-with-minio-secret-key
MINIO_BUCKET=lms-files
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=https://files.example.com

# Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-grafana-password
SENTRY_DSN=
